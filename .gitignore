node_modules

# ICGC admin divisions source download (the file we use is copied to frontend static/geo/)
divisions-administratives-*

# Eurostat LAU Europe source download (input to packages/data generate:geo)
ref-lau-*

# Wayback pulls of amiboshi.cat's Catalan songs, one folder per source page (output of
# download-amiboshi-songs.js); the ones the game plays are curated by hand into
# packages/assets/public/music/
*-mp3/

# Internet Archive album downloads, one folder per item, dropped here by hand for the
# songs a show has no Catalan broadcast recording of. Same arrangement as the pulls
# above: the mp3s the game plays are curated into packages/assets/public/music/ and the
# rest of the item — the FLACs it was ripped from, the spectrograms, the item metadata —
# stays here as the source it came out of.
evangelion-angel-thesis/

